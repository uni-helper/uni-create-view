{
  "publisher": "mrmaoddxxaa",
  "name": "create-uniapp-view",
  "displayName": "uni-create-view",
  "version": "2.3.1",
  "packageManager": "npm@12.2.1",
  "description": "快速创建 uniapp 视图与组件!",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/uni-helper/uni-create-view",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/uni-helper/uni-create-view"
  },
  "keywords": [
    "uniapp",
    "page",
    "components",
    "uni-app",
    "uni"
  ],
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "icon": "public/logo.png",
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "node_modules",
    "out",
    "public"
  ],
  "engines": {
    "vscode": "^1.137.0"
  },
  "contributes": {
    "configuration": {
      "title": "create-uniapp-view 创建 page、component 时的配置项",
      "properties": {
        "create-uniapp-view.typescript": {
          "type": "boolean",
          "default": true,
          "description": "创建视图时是否选择 TypeScript 为默认语言"
        },
        "create-uniapp-view.directory": {
          "type": "boolean",
          "default": false,
          "description": "创建视图时是否创建同名文件夹"
        },
        "create-uniapp-view.name": {
          "type": "string",
          "default": "index",
          "enum": [
            "index",
            "与文件夹同名"
          ],
          "description": "创建文件夹中生成的文件名"
        },
        "create-uniapp-view.style": {
          "type": "string",
          "default": "css",
          "enum": [
            "css",
            "scss",
            "less",
            "stylus",
            "sass"
          ],
          "description": "创建视图时 CSS 预处理器的类型"
        },
        "create-uniapp-view.scoped": {
          "type": "boolean",
          "default": true,
          "description": "创建模板时，是否使用 <style scoped>"
        },
        "create-uniapp-view.setup": {
          "type": "boolean",
          "default": true,
          "description": "创建 vue3 模板时，是否使用 <script setup>"
        },
        "create-uniapp-view.template": {
          "type": "string",
          "default": "vue3",
          "enum": [
            "vue2",
            "vue3",
            "composition-api(vue2)"
          ],
          "description": "选择创建的模板"
        },
        "create-uniapp-view.customPageTemplate": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "自定义页面模板文件的路径，相对路径以工作区根目录为基准；留空则使用内置模板。设置后忽略 template 配置"
        },
        "create-uniapp-view.customComponentTemplate": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "自定义组件模板文件的路径，相对路径以工作区根目录为基准；留空则使用内置模板。设置后忽略 template 配置"
        },
        "create-uniapp-view.nvue": {
          "type": "boolean",
          "default": false,
          "description": "创建 nvue 页面或组件（生成 .nvue 文件，内容使用 nvue 模板）"
        }
      }
    },
    "commands": [
      {
        "command": "create-uniapp-view.createPage",
        "title": "新建uniapp页面"
      },
      {
        "command": "create-uniapp-view.createSubcontractPage",
        "title": "新建uniapp页面(分包)"
      },
      {
        "command": "create-uniapp-view.createComponent",
        "title": "新建uniapp组件"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "group": "navigation@8",
          "command": "create-uniapp-view.createPage",
          "title": "新建uniapp页面",
          "when": "explorerResourceIsFolder"
        },
        {
          "group": "navigation@9",
          "command": "create-uniapp-view.createSubcontractPage",
          "title": "新建uniapp页面(分包)",
          "when": "explorerResourceIsFolder"
        },
        {
          "group": "navigation@9",
          "command": "create-uniapp-view.createComponent",
          "title": "新建uniapp组件",
          "when": "explorerResourceIsFolder"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "watch": "tsc -watch",
    "test": "npm run compile && node --test",
    "release": "bumpp --all",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "comment-json": "^4.6.2",
    "ejs": "^6.0.1",
    "slash": "^3.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.137.0",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3"
  }
}
